# ==========================================
# QuantumServiceOperationSDNarchitecture .gitignore
# ==========================================

# ------------------------------------------
# Python Environments & Virtual Envs
# ------------------------------------------
.venv/
venv/
env/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ------------------------------------------
# Python Caches & Testing Artifacts
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/

# ------------------------------------------
# Auto-Generated API Schemas (gRPC & YANG)
# ------------------------------------------
# Track source .proto and .yang files, ignore generated stubs and trees
src/api/proto/*_pb2.py
src/api/proto/*_pb2_grpc.py
!src/api/proto/__init__.py
src/api/grpc/*_pb2.py
src/api/grpc/*_pb2_grpc.py
!src/api/grpc/__init__.py
src/api/yang/*.tree

# ------------------------------------------
# Canonical Juju & Charmcraft Build Artifacts
# ------------------------------------------
.charmcraft/
charm/.charmcraft/
charm/build/
*.charm

# ------------------------------------------
# Local Configurations & Security Credentials
# ------------------------------------------
# Track template config files (e.g., config/terminal.yaml.example)
config/terminal.yaml
config/*.local.yaml
*.pem
*.key
*.crt

# ------------------------------------------
# Logs, Temporary & Runtime Files
# ------------------------------------------
*.log
logs/
tmp/
*.sqlite3

# ------------------------------------------
# IDEs & OS Files
# ------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
