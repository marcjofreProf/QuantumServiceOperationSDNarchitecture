# ==========================================
# QuantumServiceOperationSDNarchitecture .gitignore
# ==========================================

# ------------------------------------------
# Python Environments & Packages
# ------------------------------------------
.venv/
venv/
env/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ------------------------------------------
# Python Caches & Testing Artifacts
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/

# ------------------------------------------
# Auto-Generated API Schemas (gRPC & YANG)
# ------------------------------------------
# Source files in src/api/proto/ and src/api/yang/ remain tracked.
# Only compiled Python stubs and YANG tree representations are ignored.
src/api/grpc/*_pb2.py
src/api/grpc/*_pb2_grpc.py
!src/api/grpc/__init__.py
src/api/yang/*.tree

# ------------------------------------------
# Local Configurations & Security Credentials
# ------------------------------------------
# Track template files (e.g., config/terminal.yaml.example), ignore active configs
config/terminal.yaml
config/*.local.yaml
*.pem
*.key
*.crt

# ------------------------------------------
# Logs, Temporary & Runtime Files
# ------------------------------------------
*.log
logs/
tmp/
*.sqlite3

# ------------------------------------------
# Canonical Juju & Charmcraft Build Artifacts
# ------------------------------------------
charm/build/
charm/.charmcraft/
charm/*.charm
*.charm
.charmcraft/

# ------------------------------------------
# IDEs & System Files
# ------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
